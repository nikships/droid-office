{
  "name": "droid-office",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "website"
  ],
  "description": "A 3D office in the browser where its owner hires Droid workers at desks and works in their live PTYs.",
  "type": "module",
  "productName": "Droid Office",
  "author": "Nikhil Anand",
  "main": "dist/desktop/main.js",
  "bin": {
    "droid-office": "bin/droid-office.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "codegenConfig": {
    "name": "DroidOfficeSpec",
    "type": "all",
    "jsSrcsDir": "src/mobile/specs",
    "android": {
      "javaPackageName": "ai.factory.droidoffice.rn"
    }
  },
  "scripts": {
    "test": "node --import tsx --test --test-timeout=120000 tests/*.test.ts",
    "test:coverage": "node --import tsx --test --test-timeout=120000 --experimental-test-coverage --test-coverage-lines=78 --test-coverage-functions=61 --test-coverage-exclude='tests/**' tests/*.test.ts",
    "dev": "concurrently -k \"vite\" \"tsx watch src/server/cli.ts --port 4600\"",
    "build": "npm run build:client && npm run build:server && npm run build:desktop && npm run build:native",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:desktop": "tsc -p tsconfig.desktop.json && tsc -p tsconfig.desktop-page.json",
    "build:native": "node native/build.mjs",
    "build:website": "npm run build --workspace website",
    "dev:website": "npm run dev --workspace website",
    "deploy:website": "firebase deploy --only hosting --project droid-office",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.desktop.json --noEmit && tsc -p tsconfig.desktop-page.json --noEmit && npm run typecheck:mobile && npm run typecheck --workspace website",
    "typecheck:mobile": "tsc -p tsconfig.mobile.json --noEmit",
    "mobile:start": "react-native start --config metro.config.cjs",
    "mobile:bundle": "react-native bundle --config metro.config.cjs --platform android --dev false --entry-file index.mobile.js --bundle-output dist/mobile/index.android.bundle --assets-dest dist/mobile/res",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "start": "node bin/droid-office.js",
    "desktop": "npm run build && electron .",
    "package:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "prepare": "node .husky/install.mjs && npm run build"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": "biome check --write --error-on-warnings --no-errors-on-unmatched"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@factory/droid-sdk": "^0.10.0",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "electron-updater": "^6.8.9",
    "mermaid": "^12.2.0",
    "playwright-core": "1.64.0",
    "selfsigned": "^5.5.0",
    "uqr": "^0.1.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/runtime": "7.29.10",
    "@biomejs/biome": "^2.5.14",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/gradle-plugin": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/node": "^26.6.3",
    "@types/react": "19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.6",
    "dompurify": "^3.4.17",
    "electron": "^44.10.0",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "marked": "^18.0.14",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^12.4.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
