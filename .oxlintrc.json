{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "oxc"
  ],
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "no-control-regex": "off",
    "typescript/no-this-alias": "off",
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/draco_wasm_wrapper.js",
    "android/app/src/main/assets/terminal/vendor/**"
  ]
}
