native/unity/Assets/Art/**/*.fbx filter=lfs diff=lfs merge=lfs -text
native/unity/Assets/Art/**/*.png filter=lfs diff=lfs merge=lfs -text
native/unity/Assets/Art/**/*.jpg filter=lfs diff=lfs merge=lfs -text
native/unity/Assets/Art/**/*.wav filter=lfs diff=lfs merge=lfs -text
native/unity/Assets/Art/**/*.ogg filter=lfs diff=lfs merge=lfs -text
