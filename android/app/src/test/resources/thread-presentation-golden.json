{
  "version": 1,
  "about": "The Thread's presentation contract, shared by the Android app (android/.../core/ThreadView.kt, ThreadGoldenTest) and the web companion. Each case is the wire ThreadEntry list the office sends (src/shared/worker-thread.ts) and the rows a platform shows for it. Change the fixture and both projections together.",
  "schema": {
    "case": "{ name: string (unique), busy: boolean (the worker is in a turn), entries: ThreadEntry[] (wire shape, oldest first), expected: Row[] }",
    "message": "{ kind: 'message', id: entry id, role: 'user' | 'assistant', startsTurn: boolean (first assistant message after the owner's, or the first one: the only one that carries the worker's name) }",
    "notice": "{ kind: 'notice', id: entry id, text: string (the copy shown), tone: 'quiet' | 'danger' | 'attachment' }",
    "activity": "{ kind: 'activity', id: 'activity:' + first raw entry id of the run (hidden ones included), summary: string (the closed line), live: boolean (newest run while busy), items: Item[] (shown actions and thoughts, in order), failed: string[] (titles of failed actions, shown even closed), noResult: number, plan: PlanStep[] | null (the run's latest plan only when it changed since the last one shown; never a row) }",
    "action": "{ type: 'action', id: entry id, title: string (human, never a raw command, JSON or absolute home path), detail: string | null (quiet secondary line: a short path, pattern, subagent type, or a command shortened only when there is no summary), state: 'done' | 'running' | 'failed' | 'no_result' }",
    "thought": "{ type: 'thought', id: entry id, preview: string (first non-blank line, ** trimmed) }",
    "planStep": "{ status: 'completed' | 'in_progress' | 'pending', text: string }",
    "rules": [
      "A run is every consecutive tool, thinking and todo entry between messages and shown notices; a run with nothing to show leaves no row.",
      "Hidden when they succeed: TodoWrite, TodoRead, ToolSearch, Skill, and a Script followed (before the next Script) by a call the run shows. A failed one of any of them is always shown.",
      "A Script with no shown calls after it stays as 'Ran a script' (its source and result in its details).",
      "Todo snapshots are never rows.",
      "Turn ended · completed is hidden; Turn cancelled is a quiet notice; any other ending is a danger notice in words.",
      "A call with no output is 'running' only in the live run; otherwise 'no_result'. Never 'done' without output.",
      "summary: verb phrases per kind in first-seen order, files counted once each, then 'N more' actions past three kinds; failed bookkeeping isn't counted; 'Thought' for a run of only thoughts."
    ]
  },
